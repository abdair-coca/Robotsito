# Plantilla de secretos de Robot Bob.
# Copia este archivo a `.env` (mismo directorio) y rellena tu clave real.
#   cp .env.example .env
# El .env real está gitignoreado y nunca se commitea.

# Clave de la API de Groq (STT Whisper + LLM Llama). Obtenela en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui

# Clave de Gemini (LLM de charla, backend recomendado). Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_gemini_aqui

# P6 — MÚSICA (Spotify). Crea una app en https://developer.spotify.com/dashboard
# Copia Client ID y Client Secret. En "Redirect URIs" agrega EXACTAMENTE el de abajo.
# Requiere cuenta Spotify PREMIUM. La música suena por el Spotify Connect activo
# (laptop con Spotify abierto), no por el parlante del robot.
# La primera vez se abre el navegador para autorizar (token cacheado en .spotify_cache).
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
