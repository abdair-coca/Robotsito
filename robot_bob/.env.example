# Plantilla de secretos de Robot Bob.
# Copia este archivo a `.env` (mismo directorio) y rellena tu clave real.
#   cp .env.example .env
# El .env real está gitignoreado y nunca se commitea.

# Clave de la API de Groq (STT Whisper + LLM Llama). Obtenela en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui

# Clave de Gemini (LLM de charla, backend recomendado). Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_gemini_aqui
